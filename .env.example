# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=your-token-here

# BẮT BUỘC — user ID được phép dùng bot, cách nhau bởi dấu phẩy.
# Bot chạy agent với quyền shell trên máy này: để trống = ai cũng chạy được lệnh.
# Bot từ chối khởi động nếu trống (trừ khi set ALLOW_ALL_USERS=1).
TELEGRAM_ALLOWED_USERS=your-user-id
# ALLOW_ALL_USERS=1   # chỉ khi dev, cố ý mở cho tất cả

# === CLAUDE ===
# Để trống ANTHROPIC_API_KEY nếu dùng subscription (login qua `claude`)
# ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# Hỗ trợ ~ → cross-platform, không cần sửa khi đổi Mac/Linux
CLAUDE_WORKING_DIR=~/projects

# === SESSION ===
SESSION_TIMEOUT_HOURS=72

# Số project được gọi Claude CÙNG LÚC (mỗi project một mạch hội thoại riêng).
# Tin nhắn trong cùng một project vẫn chạy tuần tự. Subscription dùng chung hạn
# mức 5h nên tăng số này là tăng tốc độ đốt quota tương ứng.
MAX_CONCURRENT_PROJECTS=3

# === VOYAGE AI (optional) — bật semantic search cho memory & knowledge base ===
# Thiếu key: bot vẫn chạy, chỉ tìm kiếm bằng FTS5 (khớp từ khóa) thay vì theo ý nghĩa
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite

# === GMAIL / SHEETS (optional) ===
# Lấy từ Google Cloud Console → OAuth 2.0 Client IDs
# Chạy: bun run scripts/gmail-auth.ts để lấy refresh token
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Hỏi xác nhận qua Telegram trước khi gửi/xóa email (mặc định bật, =0 để tắt)
# GMAIL_REQUIRE_CONFIRM=0
